# Required: Your OpenRouter API key (get it at https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-...

# Optional: Model to use via OpenRouter (defaults to anthropic/claude-sonnet-4)
# OPENROUTER_MODEL=anthropic/claude-sonnet-4

# Optional: MCP server URL (defaults to production Railway deployment)
# MCP_SERVER_URL=https://mcp-gouv-sn-production.up.railway.app
